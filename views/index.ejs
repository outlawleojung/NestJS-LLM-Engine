<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <title>NestJS LLM Engine — 데모</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    :root { color-scheme: light dark; }
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      max-width: 960px; margin: 2rem auto; padding: 0 1rem; line-height: 1.6;
    }
    h1 { margin-bottom: 0.2rem; }
    .subtitle { color: #666; margin-bottom: 2rem; }
    section {
      border: 1px solid #ddd; border-radius: 8px; padding: 1.2rem 1.4rem;
      margin-bottom: 1.2rem;
    }
    section h2 { margin-top: 0; font-size: 1.15rem; }
    label { display: block; font-size: 0.9rem; margin-top: 0.6rem; font-weight: 600; }
    input, textarea, button, select {
      width: 100%; padding: 0.5rem 0.7rem; margin-top: 0.25rem;
      border: 1px solid #ccc; border-radius: 4px; font-size: 0.95rem;
      font-family: inherit;
    }
    textarea { min-height: 5rem; resize: vertical; }
    button {
      background: #2a2a2a; color: #fff; cursor: pointer;
      margin-top: 0.8rem; border: none;
    }
    button:hover { background: #444; }
    button.secondary { background: #e2e2e2; color: #222; }
    button.secondary:hover { background: #d0d0d0; }
    pre {
      background: #f5f5f5; padding: 0.8rem; border-radius: 4px;
      white-space: pre-wrap; word-break: break-word; max-height: 24rem; overflow: auto;
      font-size: 0.85rem;
    }
    .status {
      display: inline-block; padding: 0.15rem 0.5rem; border-radius: 3px;
      font-size: 0.75rem; font-weight: 600;
    }
    .status.ok { background: #d1f5d1; color: #1a5c1a; }
    .status.warn { background: #fff2cd; color: #7a5a00; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
    .muted { color: #888; font-size: 0.85rem; }
    @media (prefers-color-scheme: dark) {
      body { background: #1a1a1a; color: #e0e0e0; }
      section { border-color: #333; }
      input, textarea, select { background: #262626; color: #e0e0e0; border-color: #444; }
      pre { background: #242424; }
      .subtitle, .muted { color: #999; }
      button.secondary { background: #333; color: #eee; }
    }
  </style>
</head>
<body>
  <h1>NestJS LLM Engine</h1>
  <p class="subtitle">
    Claude 카피 생성 + Voyage 임베딩 RAG Q&amp;A 데모.
    본인의 API 키를 입력해 실행합니다. 키는 세션에 암호화 저장되며 1시간 후 만료됩니다.
  </p>

  <section>
    <h2>
      1. API 키 세션
      <span class="status <%= hasSession ? 'ok' : 'warn' %>">
        <%= hasSession ? '연결됨' : '키 필요' %>
      </span>
    </h2>
    <form id="session-form">
      <label>Anthropic API Key</label>
      <input type="password" name="anthropicApiKey" placeholder="sk-ant-..." autocomplete="off" required />
      <label>Voyage API Key</label>
      <input type="password" name="voyageApiKey" placeholder="pa-..." autocomplete="off" required />
      <div class="grid">
        <button type="submit">세션 시작</button>
        <button type="button" class="secondary" id="session-clear">세션 삭제</button>
      </div>
      <p class="muted">키는 서버에서 AES-256-GCM으로 암호화되어 Redis에 저장됩니다. TTL 1시간.</p>
    </form>
    <pre id="session-result" hidden></pre>
  </section>

  <section>
    <h2>2. 상품 등록 (등록 시 임베딩 자동 생성)</h2>
    <form id="product-form">
      <label>상품명</label>
      <input name="name" required placeholder="무선 노이즈캔슬링 헤드폰" />
      <label>카테고리</label>
      <input name="category" required placeholder="오디오/헤드폰" />
      <label>특징</label>
      <textarea name="features" required placeholder="액티브 노이즈 캔슬링, 30시간 배터리, 블루투스 5.3"></textarea>
      <button type="submit">등록</button>
    </form>
    <pre id="product-result" hidden></pre>

    <label style="margin-top:1rem;">등록된 상품</label>
    <button type="button" class="secondary" id="product-list-btn">목록 새로고침</button>
    <pre id="product-list" hidden></pre>
  </section>

  <section>
    <h2>3. 상세페이지 카피 생성 (비동기)</h2>
    <form id="copy-form">
      <label>Product ID (UUID)</label>
      <input name="productId" required placeholder="위에서 등록 후 반환된 id를 붙여넣기" />
      <button type="submit">카피 요청</button>
    </form>
    <pre id="copy-result" hidden></pre>
  </section>

  <section>
    <h2>4. RAG Q&amp;A (비동기)</h2>
    <form id="qa-form">
      <label>질문</label>
      <textarea name="question" required placeholder="노이즈 캔슬링 되고 배터리 오래가는 헤드폰 추천해줘"></textarea>
      <label>Top-K (검색할 유사 상품 수)</label>
      <input name="topK" type="number" min="1" max="20" value="5" />
      <button type="submit">Q&amp;A 요청</button>
    </form>
    <pre id="qa-result" hidden></pre>
  </section>

  <section>
    <h2>5. 요청 결과 조회 / 사용량</h2>
    <label>Request ID</label>
    <input id="request-id-input" placeholder="위 카피/Q&A 요청 후 반환된 requestId" />
    <button type="button" id="request-fetch-btn">조회</button>
    <pre id="request-result" hidden></pre>

    <label style="margin-top:1rem;">전체 사용량 (기간 미지정)</label>
    <button type="button" class="secondary" id="usage-btn">사용량 조회</button>
    <pre id="usage-result" hidden></pre>
  </section>

  <script>
    function show(el, data) {
      el.hidden = false;
      el.textContent = typeof data === 'string' ? data : JSON.stringify(data, null, 2);
    }
    async function callJson(url, options = {}) {
      const res = await fetch(url, {
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        ...options,
      });
      const text = await res.text();
      let body;
      try { body = text ? JSON.parse(text) : null; } catch { body = text; }
      if (!res.ok) throw new Error(`${res.status} ${JSON.stringify(body)}`);
      return body;
    }
    function formData(form) {
      const fd = new FormData(form);
      const obj = {};
      fd.forEach((v, k) => { obj[k] = v; });
      return obj;
    }

    document.getElementById('session-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const el = document.getElementById('session-result');
      try {
        await callJson('/session', { method: 'POST', body: JSON.stringify(formData(e.target)) });
        show(el, '세션 시작됨. 페이지를 새로고침하면 상태가 갱신됩니다.');
      } catch (err) { show(el, String(err.message)); }
    });

    document.getElementById('session-clear').addEventListener('click', async () => {
      const el = document.getElementById('session-result');
      try {
        await fetch('/session', { method: 'DELETE', credentials: 'same-origin' });
        show(el, '세션 삭제됨.');
      } catch (err) { show(el, String(err.message)); }
    });

    document.getElementById('product-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const el = document.getElementById('product-result');
      try {
        const body = await callJson('/products', { method: 'POST', body: JSON.stringify(formData(e.target)) });
        show(el, body);
      } catch (err) { show(el, String(err.message)); }
    });

    document.getElementById('product-list-btn').addEventListener('click', async () => {
      const el = document.getElementById('product-list');
      try { show(el, await callJson('/products')); }
      catch (err) { show(el, String(err.message)); }
    });

    document.getElementById('copy-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const el = document.getElementById('copy-result');
      try {
        const body = await callJson('/ai/copy', { method: 'POST', body: JSON.stringify(formData(e.target)) });
        show(el, body);
        document.getElementById('request-id-input').value = body.requestId;
      } catch (err) { show(el, String(err.message)); }
    });

    document.getElementById('qa-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const el = document.getElementById('qa-result');
      try {
        const raw = formData(e.target);
        const payload = { question: raw.question };
        if (raw.topK) payload.topK = Number(raw.topK);
        const body = await callJson('/ai/qa', { method: 'POST', body: JSON.stringify(payload) });
        show(el, body);
        document.getElementById('request-id-input').value = body.requestId;
      } catch (err) { show(el, String(err.message)); }
    });

    document.getElementById('request-fetch-btn').addEventListener('click', async () => {
      const id = document.getElementById('request-id-input').value.trim();
      const el = document.getElementById('request-result');
      if (!id) { show(el, 'Request ID를 입력해주세요.'); return; }
      try { show(el, await callJson('/ai/requests/' + encodeURIComponent(id))); }
      catch (err) { show(el, String(err.message)); }
    });

    document.getElementById('usage-btn').addEventListener('click', async () => {
      const el = document.getElementById('usage-result');
      try { show(el, await callJson('/ai/usage')); }
      catch (err) { show(el, String(err.message)); }
    });
  </script>
</body>
</html>
