# App
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/llm_engine

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Session encryption (must be at least 32 chars; used to AES-encrypt user API keys)
# 예: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-64-char-hex-random-string-please

# LLM 모델 기본값 (사용자 키는 실행 중 웹 UI에서 입력)
CLAUDE_MODEL=claude-haiku-4-5-20251001
VOYAGE_MODEL=voyage-3
